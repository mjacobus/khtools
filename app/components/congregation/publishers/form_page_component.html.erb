<div data-component="<%= bem %>" class="<%= bem %>">
  <%= render breadcrumb %>

  <%= simple_form_for(publisher, url: target_url, as: :publisher) do |f| %>
    <%= input_wrapper do %>
      <%= f.input :name %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :gender, as: :select, collection: genders %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :group_id, as: :select, collection: groups %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :user_id, as: :select, collection: users %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :email %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :phone %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :address %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :primary_emergency_contact_name %>
      <%= f.input :primary_emergency_contact_phone_number %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :secondary_emergency_contact_name %>
      <%= f.input :secondary_emergency_contact_phone_number %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.input :elder %>
      <%= f.input :ministerial_servant %>
      <%= f.input :pioneer %>
    <% end %>

    <%= input_wrapper do %>
      <%= f.submit(class: 'btn btn-primary mt-3 float-right') %>
    <% end %>
  <% end %>
</div>
