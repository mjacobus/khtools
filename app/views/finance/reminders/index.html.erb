<h1>Recorrentes</h1>
<p class="text-secondary">
  O que é preciso fazer todo mês, como pagar a internet. A partir do dia, o robô lembra no grupo
  toda manhã, marcando o responsável, até alguém tocar em ✅ Feito.
</p>

<% people = @members.map { |member| [member.display_name, member.id] } %>
<ul id="recurring" class="list-group mb-3">
  <% @reminders.each do |reminder| %>
    <li class="list-group-item">
      <%= form_with model: reminder, scope: :reminder, url: finance_reminder_path(reminder), method: :patch,
                    class: 'd-flex gap-2 flex-wrap align-items-center' do |f| %>
        <%= f.text_field :title, class: 'form-control', style: 'max-width: 20rem', required: true, aria: { label: 'Lembrete' } %>
        <div class="input-group" style="max-width: 8rem">
          <span class="input-group-text">dia</span>
          <%= f.number_field :day, class: 'form-control', min: 1, max: 31, required: true %>
        </div>
        <%= f.select :finance_telegram_member_id, people, { include_blank: 'Sem responsável' },
                     class: 'form-select', style: 'max-width: 16rem', aria: { label: 'Responsável' } %>
        <%= f.submit 'Salvar', class: 'btn btn-outline-primary' %>
        <span class="flex-grow-1 text-end">
          <% if reminder.pending?(Date.current) %>
            <small class="text-warning-emphasis">pendente</small>
          <% elsif reminder.done_month %>
            <small class="text-success">✓ feito em <%= reminder.done_month %></small>
          <% end %>
        </span>
      <% end %>
      <div class="d-flex gap-2 justify-content-end mt-2">
        <% if reminder.pending?(Date.current) %>
          <%= button_to 'Feito', done_finance_reminder_path(reminder), class: 'btn btn-sm btn-success' %>
        <% end %>
        <%= button_to finance_reminder_path(reminder), method: :delete, class: 'btn btn-sm btn-link text-secondary',
                      title: 'Remover', form: { data: { turbo_confirm: "Remover \"#{reminder.title}\"?" } } do %>
          <i class="bi bi-trash"></i> Remover
        <% end %>
      </div>
    </li>
  <% end %>
</ul>

<div class="card">
  <div class="card-header">Novo</div>
  <div class="card-body">
    <%= form_with scope: :reminder, url: finance_reminders_path, class: 'd-flex gap-2 flex-wrap' do |f| %>
      <%= f.text_field :title, class: 'form-control', style: 'max-width: 20rem', placeholder: 'Ex.: Pagamento internet', required: true, aria: { label: 'Lembrete' } %>
      <div class="input-group" style="max-width: 8rem">
        <span class="input-group-text">dia</span>
        <%= f.number_field :day, class: 'form-control', min: 1, max: 31, required: true %>
      </div>
      <%= f.select :finance_telegram_member_id, people, { include_blank: 'Sem responsável' },
                   class: 'form-select', style: 'max-width: 16rem', aria: { label: 'Responsável' } %>
      <%= f.submit 'Adicionar', class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>
