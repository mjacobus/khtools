<% due = archive_reminders.due %>
<div id="reminders-due" class="card mb-3">
  <div class="card-header d-flex">
    <span class="flex-grow-1"><i class="bi bi-bell"></i> A fazer</span>
    <%= link_to 'Recorrentes', finance_reminders_path, class: 'small' %>
  </div>
  <% if due.empty? && pending_reminders.empty? %>
    <p class="card-body mb-0 text-secondary">Nada pendente agora.</p>
  <% else %>
    <ul class="list-group list-group-flush">
      <% pending_reminders.each do |reminder| %>
        <li class="list-group-item d-flex align-items-center gap-2">
          <span class="flex-grow-1">
            <%= reminder.title %>
            <small class="d-block text-secondary">Todo mês, dia <%= reminder.day %></small>
          </span>
          <%= button_to 'Feito', done_finance_reminder_path(reminder),
                        class: 'btn btn-sm btn-success' %>
        </li>
      <% end %>
      <% due.each do |reminder| %>
        <li class="list-group-item">
          <%= reminder.title %>
          <small class="d-block text-secondary"><%= reminder.source %></small>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<div class="card mb-3">
  <div class="card-header"><i class="bi bi-journal-text"></i> Regras do arquivo</div>
  <ul id="reminders-rules" class="list-group list-group-flush">
    <% archive_reminders.rules.each do |rule| %>
      <li class="list-group-item">
        <%= rule.title %>
        <% if rule.link == :archive %>
          · <%= link_to 'Arquivar', archive_finance_documents_path %>
        <% end %>
        <small class="d-block text-secondary"><%= rule.source %></small>
      </li>
    <% end %>
  </ul>
</div>
