<% month_label = ->(month) { l(Date.parse("#{month}-01"), format: '%B de %Y').capitalize } %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<div data-turbo="true">
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <h1 class="h3 mb-0"><%= t('app.links.finance_documents') %></h1>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= link_to archive_finance_documents_path, class: 'btn btn-outline-secondary', title: 'Arquivar meses auditados' do %>
      <i class="bi bi-archive"></i> Arquivar
    <% end %>
    <% if @month %>
      <% first_day = Date.parse("#{@month}-01") %>
      <%= form_with url: finance_documents_path, method: :get, class: 'd-flex align-items-center gap-1' do %>
        <%= link_to finance_documents_path(month: first_day.prev_month.strftime('%Y-%m'), kind: params[:kind].presence),
                    class: 'btn btn-outline-secondary', title: 'Mês anterior', aria: { label: 'Mês anterior' } do %>
          <i class="bi bi-chevron-left"></i>
        <% end %>
        <%= select_tag :month, options_for_select(@months.map { |month| [month_label.call(month), month] }, @month),
                       class: 'form-select', style: 'width: 13rem', aria: { label: 'Mês' },
                       data: { searchable: false }, onchange: 'this.form.requestSubmit()' %>
        <% if params[:kind].present? %><%= hidden_field_tag :kind, params[:kind], id: nil %><% end %>
        <%= link_to finance_documents_path(month: first_day.next_month.strftime('%Y-%m'), kind: params[:kind].presence),
                    class: 'btn btn-outline-secondary', title: 'Próximo mês', aria: { label: 'Próximo mês' } do %>
          <i class="bi bi-chevron-right"></i>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success" role="alert"><%= flash[:notice] %></div>
<% end %>

<% if open_bills.any? %>
  <% overdue = open_bills.count { |bill| bill.payment_status == 'overdue' } %>
  <details id="open-bills" class="card mb-2 <%= overdue.positive? ? 'border-danger' : '' %>">
    <summary class="card-header">
      <i class="bi bi-alarm <%= 'text-danger' if overdue.positive? %>"></i>
      <%= pluralize(open_bills.size, 'fatura', plural: 'faturas') %> em aberto
      <% if overdue.positive? %>
        · <span class="text-danger"><%= pluralize(overdue, 'vencida', plural: 'vencidas') %></span>
      <% end %>
    </summary>
    <ul class="list-group list-group-flush">
      <% open_bills.each do |bill| %>
        <li class="list-group-item d-flex align-items-center gap-3">
          <%= render 'payment_badge', bill: %>
          <%= link_to bill.drive_name, payment_finance_document_path(bill), class: 'flex-grow-1 text-break' %>
          <span class="text-nowrap"><%= bill.amount_cents && Finance::Money.format(cents: bill.amount_cents) %></span>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>

<% if @cash_ledger.any? %>
  <details id="cash-ledger" class="card mb-2">
    <summary class="card-header">
      <i class="bi bi-cash-stack"></i>
      Dinheiro em mãos · <%= Finance::Money.format(cents: @cash_ledger.sum { |_, _, cents| cents.to_i }) %>
      <small class="text-muted d-block">Quem não aparece está quite.</small>
    </summary>
    <ul class="list-group list-group-flush">
      <% @cash_ledger.each do |name, count, cents| %>
        <li class="list-group-item d-flex align-items-center gap-3">
          <span class="flex-grow-1"><%= name %></span>
          <small class="text-muted text-nowrap"><%= count %> S-24</small>
          <span class="text-nowrap"><%= Finance::Money.format(cents: cents.to_i) %></span>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>

<% if @month %>
  <% done = checklist.count(&:done) %>
  <details id="checklist-panel" class="card mb-3">
    <summary class="card-header">
      <i class="bi bi-list-check <%= done == checklist.size ? 'text-success' : '' %>"></i>
      Checklist <%= done %>/<%= checklist.size %>
    </summary>
    <%= render 'checklist' %>
  </details>
<% end %>

<% kind_label = ->(kind) { kind == 'unknown' ? 'Não identificado' : Finance::Naming::LABELS.fetch(kind) } %>
<% filtered = params[:kind].present? || params[:q].present? %>

<% if @months.empty? %>
  <p class="text-muted">Nenhum documento arquivado ainda.</p>
<% else %>
  <%= form_with url: finance_documents_path, method: :get, id: 'filters', class: 'd-flex flex-wrap align-items-center gap-2 mb-2' do %>
    <%= hidden_field_tag :month, @month, id: nil %>
    <%= select_tag :kind, options_for_select([['Todos os tipos', '']] + @kinds.map { |kind| [kind_label.call(kind), kind] }, params[:kind]),
                   class: 'form-select w-auto', aria: { label: 'Tipo' }, data: { searchable: false },
                   onchange: 'this.form.requestSubmit()' %>
    <%= search_field_tag :q, params[:q], class: 'form-control w-auto flex-grow-1', style: 'max-width: 20rem',
                         placeholder: 'Buscar no nome', aria: { label: 'Buscar no nome' } %>
    <% if filtered %>
      <%= link_to 'Limpar filtros', finance_documents_path(month: @month), class: 'btn btn-link' %>
    <% end %>
  <% end %>

  <% if @documents.empty? %>
    <p class="text-muted">
      <%= filtered ? 'Nenhum documento com esses filtros.' : "Nada arquivado em #{month_label.call(@month).downcase}." %>
    </p>
  <% else %>
    <% total = @documents.filter_map(&:amount_cents).sum %>
    <% split = params[:kind] == 's24' && @documents.any? { |d| d.worldwide_cents || d.congregation_cents } %>
    <table id="documents" class="table align-middle">
      <thead>
        <tr>
          <th scope="col">Data</th>
          <th scope="col" class="d-none d-md-table-cell">Tipo</th>
          <th scope="col">Documento</th>
          <th scope="col" class="text-end">Valor</th>
          <th scope="col"><span class="visually-hidden">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% @documents.each do |document| %>
          <% kind = document.kind %>
          <tr data-kind="<%= kind %>" class="<%= 'table-warning' if kind == 'unknown' %>">
            <td class="text-secondary small text-nowrap"><%= document.document_date&.strftime('%d/%m/%Y') %></td>
            <td class="kind d-none d-md-table-cell text-nowrap">
              <% if kind == 'unknown' %><i class="bi bi-exclamation-triangle text-warning"></i><% end %>
              <%= kind_label.call(kind) %>
            </td>
            <td class="text-break">
              <% icon = { '.pdf' => 'bi-file-earmark-pdf text-danger', '.jpg' => 'bi-file-earmark-image text-primary',
                          '.jpeg' => 'bi-file-earmark-image text-primary', '.png' => 'bi-file-earmark-image text-primary' } %>
              <i class="bi <%= icon.fetch(File.extname(document.drive_name.to_s).downcase, 'bi-file-earmark text-secondary') %>"></i>
              <% if document.drive_url %>
                <%= link_to document.drive_name, document.drive_url, target: '_blank', rel: 'noopener' %>
              <% else %>
                <%= document.drive_name %>
                <span class="badge bg-secondary"><%= t("app.finance_document_states.#{document.state}") %></span>
              <% end %>
              <small class="d-block d-md-none text-muted"><%= kind_label.call(kind) %></small>
              <% if document.cash_received_at %>
                <span class="badge bg-success">💵 recebido</span>
              <% elsif document.cash_holder_name %>
                <span class="badge bg-warning text-dark">💵 com <%= document.cash_holder_name %></span>
              <% end %>
              <% if document.cash_holder_name && !document.cash_pix_at %>
                <span class="badge bg-warning text-dark">Pix pendente</span>
              <% end %>
              <% if kind == 'bill' %>
                <%= render 'payment_badge', bill: document %>
              <% elsif (paid = @paid_bills[document.bill_id]) %>
                <small class="text-muted">· pagou <%= link_to paid.drive_name, payment_finance_document_path(paid) %></small>
              <% end %>
            </td>
            <td class="text-nowrap text-end">
              <%= document.amount_cents && Finance::Money.format(cents: document.amount_cents) %>
              <% if kind == 's24' && (document.worldwide_cents || document.congregation_cents) %>
                <small class="s24-split d-block text-muted">
                  obra <%= Finance::Money.format(cents: document.worldwide_cents.to_i) %> ·
                  local <%= Finance::Money.format(cents: document.congregation_cents.to_i) %>
                </small>
              <% end %>
            </td>
            <td>
              <div class="d-flex flex-wrap justify-content-end gap-1">
                <% if document.cash_holder_name && !document.cash_received_at %>
                  <%= button_to cash_received_finance_document_path(document), class: 'btn btn-sm btn-outline-success text-nowrap',
                                                                               title: 'Recebi o dinheiro' do %>
                    <i class="bi bi-cash"></i> Recebi
                  <% end %>
                <% end %>
                <% if document.cash_holder_name && !document.cash_pix_at %>
                  <%= button_to cash_pix_finance_document_path(document), class: 'btn btn-sm btn-outline-success text-nowrap',
                                                                          title: 'Fiz o Pix' do %>
                    <i class="bi bi-send"></i> Fiz o Pix
                  <% end %>
                <% end %>
                <% if kind == 'bill' && document.drive_file_id %>
                  <%= link_to payment_finance_document_path(document), class: 'btn btn-sm btn-outline-secondary',
                                                                       title: 'Pagamento', aria: { label: 'Pagamento' } do %>
                    <i class="bi bi-cash-coin"></i>
                  <% end %>
                <% end %>
                <% if document.drive_file_id %>
                  <%= link_to edit_finance_document_path(document), class: 'btn btn-sm btn-outline-secondary',
                                                                    title: 'Editar', aria: { label: 'Editar' } do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
      <% if total.positive? && params[:kind].present? %>
        <tfoot>
          <tr>
            <td colspan="5" class="text-end text-secondary small">
              <%= pluralize(@documents.size, 'documento', plural: 'documentos') %> ·
              <% if split %>
                Obra <%= Finance::Money.format(cents: @documents.sum { |d| d.worldwide_cents.to_i }) %> ·
                Local <%= Finance::Money.format(cents: @documents.sum { |d| d.congregation_cents.to_i }) %> ·
              <% end %>
              Total <%= Finance::Money.format(cents: total) %>
            </td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  <% end %>
<% end %>
</div>
