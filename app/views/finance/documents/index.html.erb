<% month_label = ->(month) { l(Date.parse("#{month}-01"), format: '%B de %Y').capitalize } %>
<% all = all_documents_view? %>
<% reminders = reminders_view? %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<div data-turbo="true">
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <h1 class="h3 mb-0"><%= t('app.links.finance_documents') %></h1>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= link_to archive_finance_documents_path, class: 'btn btn-outline-secondary', title: 'Arquivar meses auditados' do %>
      <i class="bi bi-archive"></i> Arquivar
    <% end %>
    <% if @month && !all && !reminders %>
      <% first_day = Date.parse("#{@month}-01") %>
      <%= form_with url: finance_documents_path, method: :get, class: 'd-flex align-items-center gap-1' do %>
        <%= link_to finance_documents_path(month: first_day.prev_month.strftime('%Y-%m'), kind: params[:kind].presence),
                    class: 'btn btn-outline-secondary', title: 'Mês anterior', aria: { label: 'Mês anterior' } do %>
          <i class="bi bi-chevron-left"></i>
        <% end %>
        <%= select_tag :month, options_for_select(@months.map { |month| [month_label.call(month), month] }, @month),
                       class: 'form-select', style: 'width: 13rem', aria: { label: 'Mês' },
                       data: { searchable: false }, onchange: 'this.form.requestSubmit()' %>
        <% if params[:kind].present? %><%= hidden_field_tag :kind, params[:kind], id: nil %><% end %>
        <%= link_to finance_documents_path(month: first_day.next_month.strftime('%Y-%m'), kind: params[:kind].presence),
                    class: 'btn btn-outline-secondary', title: 'Próximo mês', aria: { label: 'Próximo mês' } do %>
          <i class="bi bi-chevron-right"></i>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<ul id="document-tabs" class="nav nav-tabs flex-nowrap text-nowrap mb-3">
  <li class="nav-item">
    <%= link_to 'Por período', finance_documents_path(month: @month),
                class: "nav-link #{'active' unless all || reminders}", aria: { current: (all || reminders ? nil : 'page') } %>
  </li>
  <li class="nav-item">
    <%= link_to 'Todos', finance_documents_path(view: 'all'), class: "nav-link #{'active' if all}",
                                                              aria: { current: (all ? 'page' : nil) } %>
  </li>
  <li class="nav-item">
    <%= link_to finance_documents_path(view: 'reminders'), class: "nav-link #{'active' if reminders}",
                                                           aria: { current: (reminders ? 'page' : nil) } do %>
      Lembretes
      <% if (due = archive_reminders.due.size + pending_reminders.size).positive? %><span class="badge bg-warning text-dark"><%= due %></span><% end %>
    <% end %>
  </li>
</ul>

<% if flash[:notice] %>
  <div class="alert alert-success" role="alert"><%= flash[:notice] %></div>
<% end %>

<% if open_bills.any? %>
  <% overdue = open_bills.count { |bill| bill.payment_status == 'overdue' } %>
  <details id="open-bills" class="card mb-2 <%= overdue.positive? ? 'border-danger' : '' %>">
    <summary class="card-header">
      <i class="bi bi-alarm <%= 'text-danger' if overdue.positive? %>"></i>
      <%= pluralize(open_bills.size, 'fatura', plural: 'faturas') %> em aberto
      <% if overdue.positive? %>
        · <span class="text-danger"><%= pluralize(overdue, 'vencida', plural: 'vencidas') %></span>
      <% end %>
    </summary>
    <ul class="list-group list-group-flush">
      <% open_bills.each do |bill| %>
        <li class="list-group-item d-flex align-items-center gap-3">
          <%= render 'payment_badge', bill: %>
          <%= link_to bill.drive_name, payment_finance_document_path(bill), class: 'flex-grow-1 text-break' %>
          <span class="text-nowrap"><%= bill.amount_cents && Finance::Money.format(cents: bill.amount_cents) %></span>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>

<% if @cash_ledger.any? %>
  <details id="cash-ledger" class="card mb-2">
    <summary class="card-header">
      <i class="bi bi-cash-stack"></i>
      Dinheiro em mãos · <%= Finance::Money.format(cents: @cash_ledger.sum { |_, _, cents| cents.to_i }) %>
      <small class="text-muted d-block">Quem não aparece está quite.</small>
    </summary>
    <ul class="list-group list-group-flush">
      <% @cash_ledger.each do |name, count, cents| %>
        <li class="list-group-item d-flex align-items-center gap-3">
          <span class="flex-grow-1"><%= name %></span>
          <small class="text-muted text-nowrap"><%= count %> S-24</small>
          <span class="text-nowrap"><%= Finance::Money.format(cents: cents.to_i) %></span>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>

<% if reminders %>
  <%= render 'reminders' %>
<% else %>
<% if @month && !all %>
  <%= render 'month_summary', summary: month_summary %>
  <% done = checklist.count(&:done) %>
  <details id="checklist-panel" class="card mb-3">
    <summary class="card-header">
      <i class="bi bi-list-check <%= done == checklist.size ? 'text-success' : '' %>"></i>
      Checklist <%= done %>/<%= checklist.size %>
    </summary>
    <%= render 'checklist' %>
  </details>
<% end %>

<% kind_label = ->(kind) { kind == 'unknown' ? 'Não identificado' : Finance::Naming::LABELS.fetch(kind) } %>
<% filtered = params[:kind].present? || params[:q].present? %>

<% if @months.empty? %>
  <p class="text-muted">Nenhum documento arquivado ainda.</p>
<% else %>
  <%= form_with url: finance_documents_path, method: :get, id: 'filters', class: 'd-flex flex-wrap align-items-center gap-2 mb-2' do %>
    <% if all %>
      <%= hidden_field_tag :view, 'all', id: nil %>
    <% else %>
      <%= hidden_field_tag :month, @month, id: nil %>
    <% end %>
    <%= select_tag :kind, options_for_select([['Todos os tipos', '']] + @kinds.map { |kind| [kind_label.call(kind), kind] }, params[:kind]),
                   class: 'form-select w-auto', aria: { label: 'Tipo' }, data: { searchable: false },
                   onchange: 'this.form.requestSubmit()' %>
    <%= search_field_tag :q, params[:q], class: 'form-control w-auto flex-grow-1', style: 'max-width: 20rem',
                         placeholder: 'Buscar no nome', aria: { label: 'Buscar no nome' } %>
    <% if filtered %>
      <%= link_to 'Limpar filtros', all ? finance_documents_path(view: 'all') : finance_documents_path(month: @month),
                  class: 'btn btn-link' %>
    <% end %>
  <% end %>

  <% if @listed.empty? %>
    <p class="text-muted">
      <% if filtered %>
        Nenhum documento com esses filtros.
      <% else %>
        Nada arquivado em <%= month_label.call(@month).downcase %>.
      <% end %>
    </p>
  <% else %>
    <% total = @listed.filter_map(&:amount_cents).sum %>
    <% s24s = @listed.select { |document| document.kind == 's24' } %>
    <% s24_total = s24s.filter_map(&:amount_cents).sum %>
    <% kind_total = total.positive? && params[:kind].present? && params[:kind] != 's24' %>
    <table id="documents" class="table align-middle">
      <thead>
        <tr>
          <th scope="col" class="d-none d-md-table-cell">Data</th>
          <% if all %><th scope="col" class="d-none d-md-table-cell">Mês</th><% end %>
          <th scope="col" class="ps-0 ps-md-2">Tipo</th>
          <th scope="col" class="text-end">Valor</th>
          <th scope="col" class="pe-0"><span class="visually-hidden">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% @documents.each do |document| %>
          <% kind = document.kind %>
          <tr data-kind="<%= kind %>" class="<%= 'table-warning' if kind == 'unknown' %>">
            <td class="text-secondary small text-nowrap d-none d-md-table-cell">
              <%= document.document_date&.strftime('%d/%m/%Y') %>
            </td>
            <% if all %>
              <td class="month text-secondary small text-nowrap d-none d-md-table-cell"><%= document.competence %></td>
            <% end %>
            <td class="kind text-break ps-0 ps-md-2">
              <% icon = { '.pdf' => 'bi-file-earmark-pdf text-danger', '.jpg' => 'bi-file-earmark-image text-primary',
                          '.jpeg' => 'bi-file-earmark-image text-primary', '.png' => 'bi-file-earmark-image text-primary' } %>
              <% if kind == 'unknown' %>
                <i class="bi bi-exclamation-triangle text-warning"></i>
              <% else %>
                <i class="bi <%= icon.fetch(File.extname(document.drive_name.to_s).downcase, 'bi-file-earmark text-secondary') %>"></i>
              <% end %>
              <%# Hovering the type shows the file name and the history (sent, confirmed, corrections). %>
              <% tooltip = [document.drive_name, *finance_document_history(document)].compact.join("\n") %>
              <% if document.drive_url %>
                <%= link_to document.drive_url, target: '_blank', rel: 'noopener', title: tooltip do %>
                  <span class="kind-label"><%= kind_label.call(kind) %></span>
                <% end %>
              <% elsif document.telegram_file_id %>
                <%= link_to file_finance_document_path(document), target: '_blank', rel: 'noopener', title: tooltip do %>
                  <span class="kind-label"><%= kind_label.call(kind) %></span>
                <% end %>
                <span class="badge bg-secondary"><%= t("app.finance_document_states.#{document.state}") %></span>
              <% else %>
                <span class="kind-label" title="<%= tooltip %>"><%= kind_label.call(kind) %></span>
                <span class="badge bg-secondary"><%= t("app.finance_document_states.#{document.state}") %></span>
              <% end %>
              <%# Only what is still pending; nothing once the cash arrived and the Pix is done. %>
              <% if document.cash_holder_name && !document.cash_received_at && !document.cash_pix_at %>
                <span class="pending-sign" role="img" title="Dinheiro com <%= document.cash_holder_name %>"
                      aria-label="Dinheiro com <%= document.cash_holder_name %>">💵</span>
              <% end %>
              <% if document.cash_holder_name && !document.cash_pix_at %>
                <span class="pending-sign" role="img" title="Pix pendente" aria-label="Pix pendente">💸</span>
              <% end %>
              <% details = document.description.presence || (Finance::Naming.short(document.drive_name) if kind == 'unknown') %>
              <% if details %>
                <small class="details text-secondary"><%= details %></small>
              <% end %>
              <% phone_line = [document.document_date&.strftime(all ? '%d/%m/%Y' : '%d/%m'),
                               (all && document.competence) ? "mês #{document.competence}" : nil].compact %>
              <% if phone_line.any? %>
                <small class="d-block d-md-none text-muted"><%= phone_line.join(' · ') %></small>
              <% end %>
              <% if kind == 'bill' %>
                <%= render 'payment_badge', bill: document %>
              <% elsif (paid = @paid_bills[document.bill_id]) %>
                <small class="text-secondary">· pagou <%= link_to [kind_label.call(paid.kind), paid.description].compact.join(' '), payment_finance_document_path(paid), title: paid.drive_name %></small>
              <% end %>
            </td>
            <td class="text-end">
              <span class="text-nowrap"><%= document.amount_cents && Finance::Money.format(cents: document.amount_cents) %></span>
              <% if kind == 's24' && (document.worldwide_cents || document.congregation_cents) %>
                <small class="s24-split d-block text-muted">
                  <span class="text-nowrap">obra <%= Finance::Money.format(cents: document.worldwide_cents.to_i) %></span>
                  <span class="text-nowrap">· local <%= Finance::Money.format(cents: document.congregation_cents.to_i) %></span>
                </small>
              <% end %>
            </td>
            <td class="pe-0">
              <div class="d-flex flex-wrap justify-content-end gap-1">
                <% if document.cash_holder_name && !document.cash_received_at && cash_receiver? %>
                  <%= button_to cash_received_finance_document_path(document), class: 'btn btn-sm btn-outline-success text-nowrap',
                                                                               title: 'Recebi o dinheiro' do %>
                    <i class="bi bi-cash"></i> Recebi
                  <% end %>
                <% end %>
                <% if document.cash_holder_name && !document.cash_pix_at %>
                  <%= button_to cash_pix_finance_document_path(document), class: 'btn btn-sm btn-outline-success text-nowrap',
                                                                          title: 'Fiz o Pix' do %>
                    <i class="bi bi-send"></i> Fiz o Pix
                  <% end %>
                <% end %>
                <% if kind == 'bill' && document.drive_file_id %>
                  <%= link_to payment_finance_document_path(document), class: 'btn btn-sm btn-outline-secondary',
                                                                       title: 'Pagamento', aria: { label: 'Pagamento' } do %>
                    <i class="bi bi-cash-coin"></i>
                  <% end %>
                <% end %>
                <% if document.state == 'suggested' %>
                  <%= button_to confirm_finance_document_path(document), class: 'btn btn-sm btn-outline-success',
                                                                         title: 'Confirmar', aria: { label: 'Confirmar' } do %>
                    <i class="bi bi-check-lg"></i>
                  <% end %>
                  <%= button_to discard_finance_document_path(document), class: 'btn btn-sm btn-outline-secondary',
                                                                         title: 'Não é das contas', aria: { label: 'Descartar' },
                                                                         form: { data: { turbo_confirm: 'Descartar? Não vai para o Drive.' } } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                <% end %>
                <% if document.drive_file_id %>
                  <%= link_to edit_finance_document_path(document), class: 'btn btn-sm btn-outline-secondary',
                                                                    title: 'Editar', aria: { label: 'Editar' } do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
      <% if s24_total.positive? || kind_total %>
        <tfoot class="text-end text-secondary small">
          <% if s24_total.positive? %>
            <tr>
              <td colspan="<%= all ? 6 : 5 %>">
                Donativos (<%= s24s.size %> S-24) ·
                Obra <%= Finance::Money.format(cents: s24s.sum { |d| d.worldwide_cents.to_i }) %> ·
                Local <%= Finance::Money.format(cents: s24s.sum { |d| d.congregation_cents.to_i }) %> ·
                Total <%= Finance::Money.format(cents: s24_total) %>
              </td>
            </tr>
          <% end %>
          <% if kind_total %>
            <tr>
              <td colspan="<%= all ? 6 : 5 %>">
                <%= pluralize(@listed.size, 'documento', plural: 'documentos') %> ·
                Total <%= Finance::Money.format(cents: total) %>
              </td>
            </tr>
          <% end %>
        </tfoot>
      <% end %>
    </table>
    <% if all %><%= paginate @documents %><% end %>
  <% end %>
<% end %>
<% end %>
</div>
