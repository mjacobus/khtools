<h1 class="h3 mb-3">Usuários</h1>

<% if flash[:notice] %>
  <div class="alert alert-success" role="alert"><%= flash[:notice] %></div>
<% end %>

<table class="table align-middle">
  <thead>
    <tr>
      <th scope="col">Nome</th>
      <th scope="col" class="d-none d-md-table-cell">Congregação</th>
      <th scope="col" class="d-none d-md-table-cell">Publicador</th>
      <th scope="col"><span class="visually-hidden">Ações</span></th>
    </tr>
  </thead>
  <tbody>
    <% @users.includes(:account, :publisher).each do |user| %>
      <tr id="user-<%= user.id %>">
        <td class="text-break">
          <% if user.avatar %>
            <%= image_tag("#{user.avatar}?sz=25", class: 'avatar-25 me-1', alt: '') %>
          <% end %>
          <%= user.name %>
          <% if user.master? %><span class="badge bg-primary">Admin</span><% end %>
          <% unless user.enabled? %><span class="badge bg-secondary">Desativado</span><% end %>
          <small class="d-block text-secondary"><%= user.email %></small>
          <small class="d-block d-md-none text-secondary">
            <%= [user.congregation_name, user.publisher&.name].compact.join(' · ') %>
          </small>
        </td>
        <td class="d-none d-md-table-cell"><%= user.congregation_name %></td>
        <td class="d-none d-md-table-cell"><%= user.publisher&.name %></td>
        <td class="text-end">
          <%= link_to edit_user_path(user), class: 'btn btn-sm btn-outline-secondary',
                                            title: 'Editar', aria: { label: "Editar #{user.name}" } do %>
            <i class="bi bi-pencil"></i>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
